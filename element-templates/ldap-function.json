{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Ldap function",
  "id": "org.camunda.connector.ldap.LdapFunction",
  "description": "Search an LDAP directory and return the matching entries with their attributes",
  "documentationRef": "https://docs.camunda.io/docs/components/modeler/web-modeler/connectors/available-connectors/template/",
  "icon": {
    "contents": "data:image/png;base64,\u003d\u003d"
  },
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:ServiceTask"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "groups": [
    {
      "id": "operation",
      "label": "Operation"
    },
    {
      "id": "ldapconnection",
      "label": "LdapConnection"
    },
    {
      "id": "search",
      "label": "Search"
    },
    {
      "id": "options",
      "label": "Options"
    },
    {
      "id": "create",
      "label": "Create"
    },
    {
      "id": "entry",
      "label": "Entry"
    },
    {
      "id": "rename",
      "label": "Rename"
    },
    {
      "id": "delete",
      "label": "Delete"
    },
    {
      "id": "Input",
      "label": "Input"
    },
    {
      "id": "Output",
      "label": "Output"
    }
  ],
  "properties": [
    {
      "binding": {
        "type": "zeebe:taskDefinition:type"
      },
      "type": "Hidden",
      "value": "c-ldap-function"
    },
    {
      "binding": {
        "key": "resultVariable",
        "type": "zeebe:taskHeader"
      },
      "type": "Hidden",
      "value": "result"
    },
    {
      "id": "ldapFunction",
      "label": "LDAP function",
      "description": "Operation to run on the directory",
      "value": "SEARCH",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Search entries",
          "value": "SEARCH"
        },
        {
          "name": "Create an entry",
          "value": "CREATE"
        },
        {
          "name": "Modify the attributes of an entry",
          "value": "MODIFY"
        },
        {
          "name": "Delete an entry",
          "value": "DELETE"
        },
        {
          "name": "Rename or move an entry",
          "value": "RENAME"
        }
      ],
      "binding": {
        "name": "ldapFunction",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "operation"
    },
    {
      "id": "host",
      "label": "Host",
      "description": "Host name or IP address of the directory server",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "host",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "ldapconnection"
    },
    {
      "id": "port",
      "label": "Port",
      "description": "Port of the directory server. Empty means 636 for LDAPS and 389 otherwise",
      "type": "Number",
      "feel": "optional",
      "binding": {
        "name": "port",
        "type": "zeebe:input"
      },
      "group": "ldapconnection"
    },
    {
      "id": "protocol",
      "label": "Protocol",
      "description": "LDAPS (TLS from the start), TLS (StartTLS) or LDAP (no encryption)",
      "value": "LDAPS",
      "type": "Dropdown",
      "choices": [
        {
          "name": "LDAPS (TLS from the start)",
          "value": "LDAPS"
        },
        {
          "name": "TLS (StartTLS)",
          "value": "TLS"
        },
        {
          "name": "LDAP (no encryption)",
          "value": "LDAP"
        }
      ],
      "binding": {
        "name": "protocol",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "ldapconnection"
    },
    {
      "id": "connectionType",
      "label": "Connection type",
      "description": "anonymous: no bind. user/password: bind with the username and password below",
      "value": "ANONYMOUS",
      "type": "Dropdown",
      "choices": [
        {
          "name": "anonymous",
          "value": "ANONYMOUS"
        },
        {
          "name": "user/password",
          "value": "USER_PASSWORD"
        }
      ],
      "binding": {
        "name": "connectionType",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "ldapconnection"
    },
    {
      "condition": {
        "property": "connectionType",
        "oneOf": [
          "USER_PASSWORD"
        ]
      },
      "id": "username",
      "label": "Username (bind DN)",
      "description": "Bind DN, for example cn\u003dsearch,dc\u003dexample,dc\u003dorg. Empty means an anonymous bind",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "username",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "ldapconnection"
    },
    {
      "condition": {
        "property": "connectionType",
        "oneOf": [
          "USER_PASSWORD"
        ]
      },
      "id": "password",
      "label": "Password",
      "description": "Required when a username is set. Use a secret, for example {{secrets.LDAP_PASSWORD}}",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "password",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "ldapconnection"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "baseDn",
      "label": "Base DN",
      "description": "DN of the entry where the search starts, for example ou\u003dpeople,dc\u003dexample,dc\u003dorg",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "baseDn",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "search"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "scope",
      "label": "Scope",
      "description": "How deep the search goes from the base DN",
      "value": "SUBTREE",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Subtree (base and all descendants)",
          "value": "SUBTREE"
        },
        {
          "name": "One level (direct children)",
          "value": "ONELEVEL"
        },
        {
          "name": "Base (base entry only)",
          "value": "BASE"
        }
      ],
      "binding": {
        "name": "scope",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "search"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "filter",
      "label": "Filter",
      "description": "LDAP search filter, for example (\u0026(objectClass\u003dinetOrgPerson)(uid\u003dalice)). Escape values taken from process variables (RFC 4515)",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "filter",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "search"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "attributes_optional",
      "label": "Provide Attributes?",
      "description": "Comma-separated attribute names to return, for example cn, mail. Empty returns all attributes",
      "value": "false",
      "binding": {
        "name": "attributes_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "search"
    },
    {
      "condition": {
        "property": "attributes_optional",
        "equals": "true"
      },
      "id": "attributes",
      "label": "Attributes",
      "description": "Comma-separated attribute names to return, for example cn, mail. Empty returns all attributes",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "attributes",
        "type": "zeebe:input"
      },
      "group": "search"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "followReferrals_optional",
      "label": "Provide Follow referrals?",
      "description": "Follow LDAP referrals to other directory servers",
      "value": "false",
      "binding": {
        "name": "followReferrals_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "options"
    },
    {
      "condition": {
        "property": "followReferrals_optional",
        "equals": "true"
      },
      "id": "followReferrals",
      "label": "Follow referrals",
      "description": "Follow LDAP referrals to other directory servers",
      "value": "false",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "binding": {
        "name": "followReferrals",
        "type": "zeebe:input"
      },
      "group": "options"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "derefAliases",
      "label": "Dereference aliases",
      "description": "How alias entries are resolved during the search",
      "value": "ALWAYS",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Always",
          "value": "ALWAYS"
        },
        {
          "name": "Never",
          "value": "NEVER"
        },
        {
          "name": "When searching",
          "value": "SEARCHING"
        },
        {
          "name": "When finding the base",
          "value": "FINDING"
        }
      ],
      "binding": {
        "name": "derefAliases",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "options"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "ldapSearchPageSize",
      "label": "LDAP search page size",
      "description": "Number of entries the directory sends per request (LDAP paged results). 0 disables paging. This is a transport setting: it does not change the result",
      "value": "100",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "ldapSearchPageSize",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "options"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "pageSize",
      "label": "Page size",
      "description": "Number of entries in one result page. 0 returns all entries",
      "value": "0",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "pageSize",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "search"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "pageNumber",
      "label": "Page number",
      "description": "Page to return, starting at 0 (0 is the first page). Ignored when page size is 0",
      "value": "0",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "pageNumber",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "search"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "CREATE",
          "DELETE"
        ]
      },
      "id": "IgnoreIfAlreadyDone",
      "label": "Ignore if already done",
      "description": "CREATE: an entry that already exists is not an error. DELETE: an entry that does not exist is not an error",
      "value": "false",
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "binding": {
        "name": "IgnoreIfAlreadyDone",
        "type": "zeebe:input"
      },
      "group": "options"
    },
    {
      "id": "timeLimit_optional",
      "label": "Provide Time limit (seconds)?",
      "description": "Maximum duration of the search in seconds. 0 means no limit",
      "value": "false",
      "binding": {
        "name": "timeLimit_optional",
        "type": "zeebe:input"
      },
      "type": "Dropdown",
      "choices": [
        {
          "name": "Yes",
          "value": "true"
        },
        {
          "name": "No",
          "value": "false"
        }
      ],
      "group": "options"
    },
    {
      "condition": {
        "property": "timeLimit_optional",
        "equals": "true"
      },
      "id": "timeLimit",
      "label": "Time limit (seconds)",
      "description": "Maximum duration of the search in seconds. 0 means no limit",
      "value": "30",
      "type": "Number",
      "feel": "optional",
      "binding": {
        "name": "timeLimit",
        "type": "zeebe:input"
      },
      "group": "options"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "CREATE"
        ]
      },
      "id": "objectClass",
      "label": "Object class",
      "description": "Object class of the new entry, for example inetOrgPerson. Separate several with commas",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "objectClass",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "create"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "MODIFY"
        ]
      },
      "id": "dn",
      "label": "DN",
      "description": "Full DN of the existing entry to modify",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "dn",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "entry"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "MODIFY"
        ]
      },
      "id": "entryAttributes",
      "label": "Attributes",
      "description": "Attributes as name/value pairs. For MODIFY, an empty value removes the attribute",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "entryAttributes",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "entry"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "RENAME"
        ]
      },
      "id": "sourceDn",
      "label": "Source DN",
      "description": "Current full DN of the entry",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "sourceDn",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "rename"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "RENAME"
        ]
      },
      "id": "destinationDn",
      "label": "Destination DN",
      "description": "New full DN of the entry",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "destinationDn",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "rename"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "CREATE"
        ]
      },
      "id": "CreateEntryDN",
      "label": "DN of the new entry",
      "description": "Full DN of the entry to create, for example uid\u003dcarol,ou\u003dpeople,dc\u003dexample,dc\u003dorg",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "CreateEntryDN",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "create"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "CREATE"
        ]
      },
      "id": "createEntryAttributes",
      "label": "Attributes of the new entry",
      "description": "Attributes as name/value pairs, for example cn, sn and mail",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "createEntryAttributes",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "create"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "DELETE"
        ]
      },
      "id": "DeleteEntryDN",
      "label": "DN of the entry to delete",
      "description": "Full DN of the entry to delete. An entry with children cannot be deleted",
      "type": "String",
      "feel": "optional",
      "binding": {
        "name": "DeleteEntryDN",
        "type": "zeebe:input"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "delete"
    },
    {
      "id": "status",
      "label": "Status",
      "description": "Result of the operation: SUCCESS, CREATED, ALREADY_CREATED, MODIFIED, DELETED, ALREADY_DELETED or RENAMED",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.status",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "SEARCH"
        ]
      },
      "id": "entries",
      "label": "Entries",
      "description": "Search: the entries matching the filter, each one with its DN and its attributes",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.entries",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "condition": {
        "property": "ldapFunction",
        "oneOf": [
          "CREATE",
          "MODIFY",
          "DELETE",
          "RENAME"
        ]
      },
      "id": "entryDn",
      "label": "DN",
      "description": "Create, modify or delete: the DN of the entry. Rename: the new DN",
      "type": "String",
      "feel": "optional",
      "binding": {
        "source": "\u003d result.entryDn",
        "type": "zeebe:output"
      },
      "constraints": {
        "notEmpty": true
      },
      "group": "Output"
    },
    {
      "label": "ControllerPage Expression",
      "description": "Expression to define BPMN Errors to throw",
      "type": "Hidden",
      "value": "if is defined(error) then bpmnError(error.code, error.message) else null",
      "binding": {
        "key": "errorExpression",
        "type": "zeebe:taskHeader"
      }
    }
  ]
}